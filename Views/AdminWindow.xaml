<Window x:Class="QuizTime.Views.AdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quiz Time - Beheer" Height="450" Width="520"
        WindowStartupLocation="CenterScreen">
    <DockPanel Margin="20">
        <TextBlock DockPanel.Dock="Top" Text="Quizzen beheren" FontSize="20" FontWeight="Bold" Margin="0,0,0,15"/>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,0">
            <Button x:Name="NewQuizButton" Content="Nieuwe quiz" Width="120" Height="30" Margin="5" Click="NewQuizButton_Click"/>
            <Button x:Name="EditQuizButton" Content="Bewerken" Width="120" Height="30" Margin="5" Click="EditQuizButton_Click"/>
            <Button x:Name="DeleteQuizButton" Content="Verwijderen" Width="120" Height="30" Margin="5"/>
        </StackPanel>
        
        <ListBox x:Name="QuizListBox">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock><Run Text="{Binding Title, Mode=OneWay}"/><Run Text=" ("/><Run Text="{Binding Questions.Count, Mode=OneWay}"/><Run Text=" vragen)"/></TextBlock>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
