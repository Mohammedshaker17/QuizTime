<Window x:Class="QuizTime.Views.AdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quiz Time - Beheer" Height="450" Width="520"
        WindowStartupLocation="CenterScreen">
    <DockPanel Margin="20">
        <TextBlock DockPanel.Dock="Top" Text="Quizzen beheren" FontSize="20" FontWeight="Bold" Margin="0,0,0,15"/>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,0">
            <Button x:Name="NewQuizButton" Content="Nieuwe quiz" Width="120" Height="30" Margin="5" Click="OpenQuizEditor_Click"/>
            <Button x:Name="EditQuizButton" Content="Bewerken" Width="120" Height="30" Margin="5" Click="OpenQuizEditor_Click"/>
            <Button x:Name="DeleteQuizButton" Content="Verwijderen" Width="120" Height="30" Margin="5"/>
        </StackPanel>

        <!-- Voorlopig vaste voorbeelditems; later komen hier de echte quizzen. -->
        <ListBox x:Name="QuizListBox">
            <ListBoxItem Content="Voorbeeldquiz - Gemengde Categorieën (4 vragen)"/>
            <ListBoxItem Content="Dierenquiz (10 vragen)"/>
            <ListBoxItem Content="Geschiedenisquiz (8 vragen)"/>
        </ListBox>
    </DockPanel>
</Window>
