<Window x:Class="QuizTime.Views.QuizEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quiz bewerken" Height="500" Width="620"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Titel van de quiz:" Margin="0,0,0,5"/>
            <TextBox x:Name="TitleTextBox" Height="25" Margin="0,0,0,15"/>
            <TextBlock Text="Vragen:" Margin="0,0,0,5"/>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button x:Name="SaveButton" Content="Opslaan" Width="100" Height="30" Margin="5" Click="SaveButton_Click"/>
            <Button x:Name="CancelButton" Content="Annuleren" Width="100" Height="30" Margin="5" IsCancel="True"/>
        </StackPanel>

        <StackPanel DockPanel.Dock="Right" Margin="10,0,0,0">
            <Button x:Name="AddQuestionButton" Content="Vraag toevoegen" Width="130" Height="30" Margin="0,0,0,5" Click="OpenQuestionEditor_Click"/>
            <Button x:Name="EditQuestionButton" Content="Vraag bewerken" Width="130" Height="30" Margin="0,0,0,5" Click="OpenQuestionEditor_Click"/>
            <Button x:Name="DeleteQuestionButton" Content="Vraag verwijderen" Width="130" Height="30" Margin="0,0,0,5"/>
        </StackPanel>

        <ListBox x:Name="QuestionListBox"/>
    </DockPanel>
</Window>
