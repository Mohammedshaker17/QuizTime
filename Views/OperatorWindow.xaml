<Window x:Class="QuizTime.Views.OperatorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quiz Time - Operator" Height="380" Width="400">
    <StackPanel Margin="20" VerticalAlignment="Center">
        <TextBlock Text="Quiz Time - Bediening" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>

        <TextBlock x:Name="StatusText" Text="Nog geen quiz gestart." Margin="0,0,0,15" TextWrapping="Wrap"/>

        <!-- Keuzelijst waarmee de operator een categorie kiest voordat de quiz start -->
        <TextBlock Text="Kies een categorie:" Margin="0,0,0,5"/>
        <ComboBox x:Name="CategoryComboBox" Height="30" Margin="0,0,0,15"/>

        <Button x:Name="StartPlayButton" Content="Start Quiz Spelen" Height="35" Margin="0,0,0,10" Click="StartPlayButton_Click"/>
        <Button x:Name="StartReviewButton" Content="Start Quiz Nakijken" Height="35" Margin="0,0,0,20" Click="StartReviewButton_Click"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <Button x:Name="PreviousButton" Content="Vorige vraag" Width="120" Height="30" Margin="5" Click="PreviousButton_Click"/>
            <Button x:Name="NextButton" Content="Volgende vraag" Width="120" Height="30" Margin="5" Click="NextButton_Click"/>
        </StackPanel>

        <Button x:Name="RevealAnswerButton" Content="Toon juiste antwoord" Height="30" Margin="0,10,0,0" Click="RevealAnswerButton_Click" Visibility="Collapsed"/>
    </StackPanel>
</Window>