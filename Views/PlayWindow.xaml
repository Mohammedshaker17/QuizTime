<Window x:Class="QuizTime.Views.PlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quiz Time - Speelscherm" Height="500" Width="800"
        Background="#1E1E2F" WindowStartupLocation="CenterScreen">
    <Grid Margin="40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Rij met de categorie (links) en de aftel-timer (rechts) naast elkaar -->
        <DockPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock x:Name="CategoryText" DockPanel.Dock="Left" Text="" FontSize="20"
                       Foreground="#AAAAFF" FontWeight="SemiBold"/>
            <TextBlock x:Name="TimerText" DockPanel.Dock="Right" Text="" FontSize="28" Foreground="White"/>
        </DockPanel>

        <!-- De vraagtekst -->
        <TextBlock x:Name="QuestionText" Grid.Row="1" Text="Wachten op vraag..." FontSize="32"
                   FontWeight="Bold" Foreground="White" TextWrapping="Wrap" Margin="0,0,0,30"/>

        <!-- De antwoordmogelijkheden -->
        <ItemsControl x:Name="OptionsList" Grid.Row="2">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Background="{Binding Background}" CornerRadius="8" Margin="0,0,0,10" Padding="15">
                        <TextBlock Text="{Binding Text}" FontSize="22" Foreground="White"/>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</Window>